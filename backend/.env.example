# Copie para .env (ou exporte no shell) antes de subir a aplicacao.
# Nenhum destes valores deve ser versionado no GitHub.

# Chave de assinatura do JWT: minimo de 32 caracteres.
# Gere uma com: openssl rand -base64 48
JWT_SECRET=

# Origens liberadas no CORS, separadas por virgula.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Envie o cookie de refresh apenas por HTTPS (use true em producao).
COOKIE_SECURE=false

# Contas de demonstracao criadas no primeiro start (desative em producao).
DEMO_USER=true

# --- Resend: envio do e-mail de redefinicao de senha ---
# Chave de API criada em https://resend.com/api-keys. Sem ela o e-mail nao e
# enviado e o link aparece apenas no log da aplicacao.
RESEND_API_KEY=

# Remetente. Use onboarding@resend.dev para testar (so entrega no e-mail da
# propria conta Resend) ou um endereco de dominio verificado em producao.
MAIL_FROM=Sentinela <onboarding@resend.dev>

# Endereco opcional de resposta.
MAIL_REPLY_TO=

# Origem usada para montar o link do e-mail. Em dev e o servidor do Vite;
# em producao, a URL publica da aplicacao.
APP_BASE_URL=http://localhost:5173

# Somente para o perfil prod (PostgreSQL)
# DATABASE_URL=jdbc:postgresql://localhost:5432/sentinela
# DB_USERNAME=sentinela
# DB_PASSWORD=
